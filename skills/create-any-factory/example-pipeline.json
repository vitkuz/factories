{
  "$schema": "../pipeline.schema.json",
  "id": "video-factory",
  "constants": {
    "rootPath": "cwd",
    "skillPath": ".",
    "homePath": "~",
    "factoryPath": "{{rootPath}}/factories/{{id}}",
    "language": "English"
  },
  "params": {
    "topic": "WSL tips",
    "angles": 10,
    "min_angles": 3
  },
  "outputDir": "{{rootPath}}/run/{{id}}/{{slug}}-{{date}}",
  "hooks": {
    "before": [
      "cp {{factoryPath}}/pipeline.json {{outputDir}}/pipeline.json"
    ],
    "after": [
      "bash {{rootPath}}/factories/scripts/ai-usage-ingest.sh {{outputDir}}"
    ]
  },
  "START": [
    "scout"
  ],
  "steps": {
    "scout": {
      "agent": "general-purpose",
      "model": "sonnet",
      "system": [
        "You are a channel researcher. You favour angles with a concrete hook over broad topics."
      ],
      "prompt": [
        "Find {{angles}} angles on {{topic}} in {{language}}.",
        "Return DONE and report `found` as the number of angles you actually found."
      ],
      "input": [],
      "output": [
        "1-scout/angles.md"
      ],
      "transitions": {
        "THIN": {
          "condition": "found < min_angles",
          "target": [
            "scout"
          ],
          "max": 1,
          "onMax": [
            "pick"
          ]
        },
        "DONE": {
          "target": [
            "pick"
          ]
        }
      }
    },
    "pick": {
      "agent": "human",
      "prompt": [
        "Read 1-scout/angles.md.",
        "Answer SELECT <number> to pick one angle, or REGENERATE for a fresh set.",
        "You may REGENERATE at most twice."
      ],
      "input": [
        "1-scout/angles.md"
      ],
      "output": [
        "2-pick/decision.md"
      ],
      "transitions": {
        "SELECT": {
          "target": [
            "write",
            "polish"
          ]
        },
        "REGENERATE": {
          "target": [
            "scout"
          ],
          "max": 2,
          "onMax": [
            "write",
            "polish"
          ]
        }
      }
    },
    "write": {
      "agent": "general-purpose",
      "model": "opus",
      "system": [
        "You are a scriptwriter. You write for the ear, not the page: short sentences, no lists."
      ],
      "prompt": [
        "Write the script for {{topic}} using only the chosen angle."
      ],
      "input": [
        "2-pick/decision.md"
      ],
      "output": [
        "3-write/*.draft.md"
      ],
      "transitions": {
        "DONE": {
          "target": [
            "ship"
          ]
        }
      }
    },
    "polish": {
      "agent": "general-purpose",
      "model": "sonnet",
      "system": [
        "You are a thumbnail designer. Every idea you give must be readable at 120px wide."
      ],
      "prompt": [
        "Draft thumbnails for {{topic}}."
      ],
      "input": [
        "2-pick/decision.md"
      ],
      "output": [
        "4-polish/thumbs.md"
      ],
      "transitions": {
        "DONE": {
          "target": [
            "ship"
          ]
        }
      }
    },
    "ship": {
      "agent": "general-purpose",
      "model": "haiku",
      "prompt": [
        "Assemble the final package for {{topic}}."
      ],
      "input": [
        "3-write/*.draft.md",
        "4-polish/thumbs.md"
      ],
      "output": [
        "5-ship/package.md"
      ],
      "transitions": {
        "DONE": {
          "target": [
            "END"
          ]
        }
      }
    }
  }
}
