{
  "name": "record-processing",
  "version": "0.1.0",
  "private": true,
  "description": "Records a quote-to-question run's result files (as S3 keys) on the quote's `processing` field through the q-and-a API",
  "bin": {
    "record-processing": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "lint": "eslint .",
    "test": "node --require ts-node/register --test $(find src -name '*.test.ts' | sort)",
    "format": "prettier --write \"*.{ts,mjs,json}\" \"src/**/*.ts\"",
    "format:check": "prettier --check \"*.{ts,mjs,json}\" \"src/**/*.ts\"",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "dotenv": "^18.0.7",
    "uuid": "^11.1.1",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.71.1"
  }
}
