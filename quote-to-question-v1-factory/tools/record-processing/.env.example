# The q-and-a API: base URL (…/prod, no trailing slash needed) and an API key (x-api-key). Copy from repos/tools/.env.
API_URL=
API_KEY=
# The local results repository; S3 keys are paths relative to it.
RESULTS_DIR=/home/kuzmenka/vitkuz-quotes-and-answers/repos/quotes-to-question
# Optional S3 key prefix (a trailing "/" is added when missing). Empty = no prefix.
S3_PREFIX=
# Optional default for --skill.
SKILL_ID=quote-to-question-v1-factory
# error | warn | info | debug (logs go to stderr)
LOG_LEVEL=info
