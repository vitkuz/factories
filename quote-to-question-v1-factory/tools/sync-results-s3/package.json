{
  "name": "sync-results-s3",
  "version": "0.1.0",
  "private": true,
  "description": "Syncs the quote-to-question results folder to S3 (upload missing or changed files, never delete)",
  "bin": {
    "sync-results-s3": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --require ts-node/register --test $(find src -name '*.test.ts' | sort)",
    "format": "prettier --write \"src/**/*.ts\" \"*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.mjs\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/credential-providers": "^3.1149.0",
    "dotenv": "^18.0.7",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.71.1"
  }
}
