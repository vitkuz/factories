# The q-and-a API: base URL (…/prod, no trailing slash needed) and this tool's own API key (x-api-key).
# Create the key once with `npm run --silent api-key -- create pick-quote` in repos/tools; it is printed only once.
API_URL=
API_KEY=
# The console search URL used when --url is not given (a full https://…/search?… URL or only its query).
DEFAULT_SEARCH_URL=https://d2m48kxqpanigi.cloudfront.net/search?q=%D0%90%D1%80%D0%B8%D1%81%D1%82%D0%BE%D1%82%D0%B5%D0%BB%D1%8C&scope=author&processed=false
# error | warn | info | debug (logs go to stderr)
LOG_LEVEL=warn
